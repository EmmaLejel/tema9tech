---
import "../styles/global.css"
import Layout from "../layouts/Layout.astro"
import Studios from "../components/Studios.astro";
import Udstyr from "../components/Udstyr.astro";
import Studiekort from "../components/Studiekort.astro";

const apiurl = "https://qyjbtbvaznmdaetlwbom.supabase.co/rest/v1/";
const studiosTableName = "studios";
const equipmentTableName = "equipment";

/********** smid aldrig en secret key ind i Github!!!! ************/
const key = "sb_publishable_EjngztgPh6-DZBQgeRY6dQ_tiyq7nGO"
const options = {
	headers: { 
apikey: key,
	},
}
 
const studiosresponse =  await fetch (apiurl + studiosTableName, options);
const studiosData = await studiosresponse.json();
console.log("studiosData", studiosData);

const equipmentresponse = await fetch(apiurl + equipmentTableName, options);
const equipmentData = await equipmentresponse.json();
--- 
<Layout>
    <Studiekort /> 
	<section class="intro">
		<h1>Studios</h1>
        <h2>Find de rette rammer til dit næste projekt.</h2>
         <p>I Tech & Story Lab kan du booke og låne de tre forskellige studier til dine kreative projekter</p>
         <p>Tjek om studiet er ledigt og book her</p>
    </section>
    <section class="billedegrid">
         {
        studiosData.map((studio) => {
            return <Studios studio={studio} />
        })
    }
    
    </section>
    <section>
       <section>
<a class="button book_button" href="#">BOOK</a>
    </section>
    </section>
    <section class="intro">
        <h2>
            Mangler du udstyr til dine ideer?
        </h2>
        <p>
            Udforsk vores store udvalg af udstyr til dine kreative projekter
        </p>
    </section>
    <section class="udstyr-kort">
    {
        equipmentData.map((udstyr) => {
            return <Udstyr data={udstyr} />
        })
    }
</section>

    <section>

    </section>
     <section>
<a class="button udforsk-udstyr_button" href="udstyrsliste">Udforsk alt udstyr</a>
    </section>
</Layout>


<style>
.billedegrid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: 10px;
    max-width: 1300px;
    height: 700px;
    margin: 40px auto 80px;

}/* Eye tracking */
:global(.billedegrid > .studiocard:nth-child(1)) {
    grid-column: 1;
    grid-row: 1;
}

/* Photo & video */
:global(.billedegrid > .studiocard:nth-child(2)) {
    grid-column: 2;
    grid-row: 1 / 3;
}

/* Podcast */
:global(.billedegrid > .studiocard:nth-child(3)) {
    grid-column: 1;
    grid-row: 2;
}

/* booking knappen styling*/
.book_button {
      display: block;
    width: fit-content;
    margin: 2rem auto;
}

/* Se udstyr scrollbar styling*/
.udstyr-kort {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    padding: 1rem;
}

/* Udforsk alt udstyr knappen styling*/
.udforsk-udstyr_button {
     display: block;
    width: fit-content;
    margin-left: auto;
    margin-right: 2rem; 
    margin-top: 2rem;
    margin-bottom: 7rem;
}



</style>