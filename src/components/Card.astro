---
import "../styles/global.css"
const{headline, text} = Astro.props;

---

<section>
	<h2>{headline}</h2>
    <p>{text}</p>
</section>


<style>



//** HERO **//

.hero_text{
text-align: center;
  max-width: 750px;
  margin: 0 auto;
}

//** HERO BILLEDER **/

.hero_image{
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    max-width: 1100px;
    margin: 30px auto;

}

.hero_image img{
    width: 100%;
    height: 250px;
    object-fit: cover;
}


/*** teamet ****/

.baggrund {
background-color: var(--primary);
padding: 4rem 2rem;
box-sizing: border-box;
 width: 100vw;
    margin-left: calc(50% - 50vw);

}

  .teamet {
    list-style: none;
    margin: 0;
    padding: 0;
     display: grid;
  grid-template-columns: repeat(4, 220px);
    gap: 2rem;
    flex-wrap: wrap;        
  }

    .person {
    background-color: var(--secondary);
    border-radius: 8px;
    padding: 0.9rem;
    width: 20px;
    color: #fff;
    font-size: 0.9rem;
    box-sizing: border-box;
  }

  .grid_1{
    max-width: 1200;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    padding: 2rem 1rem;
    gap: 1rem;
    
  }

  .grid_1 img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }


</style>
