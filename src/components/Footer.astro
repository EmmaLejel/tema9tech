---
import { Image } from "astro:assets";
import logoekImage from "../assets/techandstorylab/logoek.png";
---
 <footer class="site-footer">
    <div>
        <Image class="logo" src={logoekImage} alt="EK logo" width="300"/>
    </div>
    <div>
      <h3>Åbningstider i labet</h3>
      <p>Mandag-Onsdag: 8:00-15:00</p>
       <p>Torsdag-Fredag: 8:00-14:00</p>
    </div>
    <div>
        <p>E-mail:</p>
         <a>techandstorylab@ek.dk</a>
          <p>Instagram:</p>
          <a>@techandstorylab</a>
           <p>LinkedIn:</p>
           <a>Techandstorylab</a>
    </div>
  </footer>

  <style>
    /* ---------- Footer ---------- */
.site-footer {
background-color: var(--primary);
  border-top: 1px solid var(--primary);
  font-size: 1rem;
   display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  justify-content: space-between;
 gap: 0.5rem 2rem;
  padding-top: 50px;
  padding-bottom: 50px; 
}
p{
color: var(--secondary);
margin: 0;
margin-top: 10px;
}
a{
   margin-bottom: 30px;
    color: var(--secondary);
}
a:hover{
   margin-bottom: 30px;
    color: var(--secondary);
    text-decoration-line: underline;
}
h3{
    color: var(--secondary);
margin-bottom: 30px;
}
.logo{
    padding-left: 50px;
}
  </style>