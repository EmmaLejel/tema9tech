---
import "../styles/global.css"
const {data} = Astro.props;

---

<article class="card">
    <img src={data.image}>
    <h3>{data.name}</h3>
    <a href=`/udstyr/${data.id}`>Læs mere</a>
</article>


  <style>
  
    h3{
        color: var(--white);
         margin-bottom: 6px;
        }
    a{
        color: var(--white);
        text-decoration-line: underline;
        }
    
  </style>

