---
import "../styles/global.css"
const {data} = Astro.props;

---

<article>
    <img src={data.image}>
    <h3>{data.name}</h3>
    <a href=`/udstyr/${data.id}`>Læs mere</a>
</article>

<style>
    .baggrundscard{
        background-color: var(--primary);
    }
    h3{
        color: var(--white);
    }
    a{
        color: var(--white);
    }
</style>
