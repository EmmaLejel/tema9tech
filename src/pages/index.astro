---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro"
import { Image } from "astro:assets";
import labsImage10 from "../assets/techandstorylab/Labs_10.jpg";
import labsImage3 from "../assets/techandstorylab/Labs_3.jpg";
import labsImage2 from "../assets/techandstorylab/Labs_2.jpg";
import labsImage1 from "../assets/techandstorylab/Labs_1.jpg";
import labsImage11 from "../assets/techandstorylab/Labs_11.jpg";
import labsImage12 from "../assets/techandstorylab/Labs_12.jpg";
import labsImage13 from "../assets/techandstorylab/Labs_13.jpg";
import labsImage14 from "../assets/techandstorylab/Labs_14.jpg";
import labsImage15 from "../assets/techandstorylab/Labs_15.jpg";
import Card from "../components/Card.astro";
import TeamCard from "../components/Teamcard.astro";
// import Image from "astro/components/Image.astro";

/* fetch data fra supabase */
const apiurl = "https://qyjbtbvaznmdaetlwbom.supabase.co/rest/v1/";
const eventsTableName = "events";
const studiosTableName = "studios";
const teamTableName = "Team";

/********** smid aldrig en secret key ind i Github!!!! ************/
const key = "sb_publishable_EjngztgPh6-DZBQgeRY6dQ_tiyq7nGO"
const options = {
	headers: { 
apikey: key,
	},
}

const eventsresponse =  await fetch (apiurl + eventsTableName, options);
const eventsData = await eventsresponse.json();
console.log("eventsData", eventsData);

const studiosresponse =  await fetch (apiurl + studiosTableName, options);
const studiosData = await studiosresponse.json();
console.log("studiosData", studiosData);

const teamresponse =  await fetch (apiurl + teamTableName, options);
const teamData = await teamresponse.json();
console.log("teamData", teamData);
---
<Layout>

<!-- hero sektion video -->
<video class="herovideo" autoplay loop playsinline>
	<source src="/herosektionvid_techstory.mp4" type="video/mp4"/>
</video>


<!-- Udstyr og video cta genvej -->
<section class="center">
  <Card headline="Se udstyr og studios" text="Find udstyr og kreative studier til dit næste projekt."/>

<div class="cta-grid">
		<!-- Studios -->
        <a href="/studios" class="cta-billede">
            <Image 
                src={labsImage10} alt="Billede af fotostudie" width="500"
            />
            <div class="cta-overlay">
                <h2>STUDIOS</h2>
            </div>
        </a>

        <!-- Udstyr -->
        <a href="/udstyrsliste" class="cta-billede">
            <Image 
                src={labsImage3} alt="Billede af VR udstyr" width="500"
            />
            <div class="cta-overlay">
                <h2>UDSTYR</h2>
            </div>
        </a></div>

</section>


<!-- 3D video implementering af labbet (fået hjælp af AI)-->
<!--Matterport er en platform, der laver interaktive 3D-rundvisninger af fysiske lokaler og bygninger.-->
<!-- iframe Indsætter eksternt indhold fra Matterport -->
<!-- Allowfullscreen giver mulighed for at vise rundvisningen i fuld skærm -->
 <section class="matterport-section"> 
	<Card headline="Udforsk og oplev labbet" text="Kom helt tæt på og udforsk Tech & Story Lab."/>

    <div class="matterport-container"> 
        <iframe
            src="https://my.matterport.com/show/?m=KcfuPDJ3H2F"
            allowfullscreen
        ></iframe> 
    </div>
</section>

<!-- Inspirationsbilleder fra labbet -->
<section class="center">
	<Card headline="Udforsk. Eksperimentér. Skab." text="Få inspiration fra idéer og eksperimenter, som studerende og undervisere har skabt med teknologi i Tech & Story Lab."/>
</section>

<section class="background inspirations-slide">

 <div class="inspirations-track">

    <div class="inspirations-billeder">
    <Image src={labsImage1} alt="Billede fra labbet" width="370" />
    <Image src={labsImage2} alt="Billede fra labbet" width="370" />
    <Image src={labsImage3} alt="Billede fra labbet" width="370" />
    <Image src={labsImage10} alt="Billede fra labbet" width="370" />
    <Image src={labsImage11} alt="Podcaststudie" width="370" />
    <Image src={labsImage12} alt="Fotostudie" width="370" />
    <Image src={labsImage13} alt="Arbejde med tøj" width="370" />
    <Image src={labsImage14} alt="Billede fra labbet" width="370"/>
    <Image src={labsImage15} alt="Billede fra labbet" width="370" />    
    </div>

    <div class="inspirations-billeder">
    <Image src={labsImage1} alt="Billede fra labbet" width="370" />
    <Image src={labsImage2} alt="Billede fra labbet" width="370" />
    <Image src={labsImage3} alt="Billede fra labbet" width="370" />
    <Image src={labsImage10} alt="Billede fra labbet" width="370" />
    <Image src={labsImage11} alt="Podcaststudie" width="370" />
    <Image src={labsImage12} alt="Fotostudie" width="370" />
    <Image src={labsImage13} alt="Arbejde med tøj" width="370" />
    <Image src={labsImage14} alt="Billede fra labbet" width="370" />
    <Image src={labsImage15} alt="Billede fra labbet" width="370" />    
    </div>

    </div>

</section>
<section class="center">
	 <h2>Det sker i labbet</h2>

                    <p>November</p>

                    <ul>
                        <li>AI Workshop</li>
                        <li>Tech Bingo</li>
                        <li>VR Experience Day</li>
                        <li>Photo Challenge</li>
                    </ul>
</section>
	<section class="center">
		<Card headline="Teamet" text="Mød personerne bag labbet, og find ud af hvem du kan gå til for inspiration, sparring og hjælp."/>
	</section>
	
<section class="background">
    <section class="team-grid">
        {teamData.map((member) => (
            <TeamCard member={member} />
        ))}
    </section>
</section>
<section class="center">
		<h2>Ofte stillede spørgsmål</h2>

						<ul class="spørgsmål">
							<li>Åbningstider</li>
							<li>Hvem kan bruge Tech & Story Lab?</li>
							<li>Hvordan booker eller låner jeg udstyr?</li>
							<li>Kan jeg få hjælp og vejledning?</li>
						</ul>
	</section>
</Layout>