---
import "../styles/global.css";
import { Image } from "astro:assets";
import labsImage10 from "../assets/techandstorylab/Labs_10.jpg";
import labsImage3 from "../assets/techandstorylab/Labs_3.jpg";
import Card from "../components/Card.astro";
const apiurl = "https://qyjbtbvaznmdaetlwbom.supabase.co/rest/v1/";
const equipmentTableName = "equipment";
const eventsTableName = "events";
const studiosTableName = "studios";

/********** smid aldrig en secret key ind i Github!!!! ************/
const key = "sb_publishable_EjngztgPh6-DZBQgeRY6dQ_tiyq7nGO"
const options = {
	headers: { 
apikey: key,
	},
}

const equipmentresponse =  await fetch (apiurl + equipmentTableName, options);
const equipmentData = await equipmentresponse.json();
console.log("equipmentData", equipmentData);

const eventsresponse =  await fetch (apiurl + eventsTableName);
const eventsData = await eventsresponse.json();
console.log("eventsData", eventsData);

const studiosresponse =  await fetch (apiurl + studiosTableName);
const studiosData = await studiosresponse.json();
console.log("studiosData", studiosData);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link rel="stylesheet" href="https://use.typekit.net/dyk7emh.css">
		<title>Techandstorylab</title>
	</head>
	<body>
		
		<h1>Tech and Story Lab</h1>
		<section>
			
					<Card headline="Se udstyr og studios" text="Find udstyr og kreative studier til dit næste projekt."/>
					<Image src={labsImage10} alt="billede af fotostudie" width="500"/>
					<Image src={labsImage3} alt="billede af udstyr" width="500"/>
		</section>
		<section>
		
					<Card headline="Udforsk og oplev labbet" text="Kom helt tæt på og udforsk Tech & Story Lab."/>
		</section>
<section>
                
					<Card headline="Udforsk. Eksperimentér. Skab." text="Få inspiration fra idéer og eksperimenter, som studerende
                        og undervisere har skabt med teknologi i Tech & Story Lab."/>
</section>
<section>
	 <h2>Det sker i labbet</h2>

                    <p>November</p>

                    <ul>
                        <li>AI Workshop</li>
                        <li>Tech Bingo</li>
                        <li>VR Experience Day</li>
                        <li>Photo Challenge</li>
                    </ul>
</section>
<section>
					<Card headline="Teamet" text="Mød personerne bag labbet, og find ud af hvem du kan gå til
                        for inspiration, sparring og hjælp."/>
</section>
<section>
	 <h2>Ofte stillede spørgsmål</h2>

                    <ul>
                        <li>Åbningstider</li>
                        <li>Hvem kan bruge Tech & Story Lab?</li>
                        <li>Hvordan booker eller låner jeg udstyr?</li>
                        <li>Kan jeg få hjælp og vejledning?</li>
                    </ul>
</section>
		
		
	</body>
</html>
