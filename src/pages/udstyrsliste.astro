         <p>Ingen online reservation. Bare kom forbi.</p>
    </section>
    <section>
        <h3>Kategorier</h3>
         <h3>Underkategorier</h3>
    </section>
    <section class="baggrundscard">
        <div>
                {
                    equipmentData.map((udstyr) => {
                        return <Udstyr data={udstyr} />
                    })
                }
        </div>

    </section>
</Layout>