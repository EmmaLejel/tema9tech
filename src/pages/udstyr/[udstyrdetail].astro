---
import Studiekort from "../../components/Studiekort.astro";
export async function getStaticPaths() {
  const apiurl = "https://qyjbtbvaznmdaetlwbom.supabase.co/rest/v1/";
  const equipmentTableName = "equipment";

  /********** smid aldrig en secret key ind i Github!!!! ************/
  const key = "sb_publishable_EjngztgPh6-DZBQgeRY6dQ_tiyq7nGO"
  const options = {
	  headers: { 
      apikey: key,
	  },
  }

  const equipmentresponse =  await fetch (apiurl + equipmentTableName, options);
  const equipmentData = await equipmentresponse.json();

  // den her function laver et ukendt antal sider på baggrund af data der bliver smidt ind
  // params er et objekt, der som minimum skal have et parabel der hedder det som filen?

  return equipmentData.map((equipment) => {
    return {
        params: { udstyrdetail: equipment.id.toString() },
        props: { equipment },
      };
    });
  }

  const { equipment } = Astro.props;
    import Layout from "../../layouts/Layout.astro";
---
<Layout>
  <Studiekort /> 
  <a href="/udstyrsliste" class="back-arrow">
    ←
</a>
  <div class="equipment-detail">
<h1>{equipment.name}</h1>
<p>{equipment.category}</p>
<p>{equipment.subcategory}</p>
 <img class="image-container" src={equipment.image}>
 </div>
   <section>
<a class="button" href="#">Se ledige tider</a>
    </section>
    <section class="guide">
      <h3>Sådan gør du:</h3>
      <p>Klik på ledige tider og se om udstyret er ledigt</p>
      <p>Er udstyret ledigt den dag du skal bruge det, går du ned i labbet, viser dit studiekort og fortæller navnet på det udstyr du vil leje</p>
      <p>Har du spørgsmål til noget, må du altid komme forbi og spørge!</p>
      <p>HUSK studiekort</p>
    </section>
</Layout>

<style>
  .guide {
    padding-left: 7rem;
    padding-bottom: 7rem;
  }
  .equipment-detail {
  max-width: 1200px;
  margin: 0 auto;
  padding: 2rem;
  position: relative;
}

.image-container {
  border: 4px solid var(--primary);
  padding: 2rem;
  /* width: fit-content; */
  margin-inline: auto;
   display: flex;
  justify-content: center;
  align-items: center;
  background-color: var(--white);
}

.image-container img {
  width: 100%;
  max-width: 450px;
  display: block;
}

.button {
  display: block;
  width: fit-content;
  margin-left: 60rem;
  margin-top: 3rem;
  padding: 1rem 3rem;
  margin-bottom: 40px;
} 

.back-arrow {
  font-size: 4rem;
  text-decoration: none;
  color: var(--primary);

  position: absolute;
  left: 2rem;
  top: 2rem;
}
</style>